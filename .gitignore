# Build, SDK and generated render/publish data; local artwork is never deleted.
**/bin/
**/obj/
/.tools/
/app/
/app-v*/
/publish/
/artifacts/
/build/
/dist/
/outputs/
/backups/
/RenderSettings/

# Legacy binary fixtures are generated by tracked tests/create_*.py.
# Intentional PNG and Blender assets elsewhere remain eligible for tracking.
/tests/fixture.blend
/tests/fixture-parented.blend
/tests/fixture-large.blend
/tests/animated-machine.blend

# Local IDE state, preferences, logs and temporary data.
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.log
*.tmp
*.temp
*.bak
*.blend[0-9]*
__pycache__/
*.pyc
*.pyo
preferences.json
render-history.json
*.local.json
*.local.ps1
.DS_Store
Thumbs.db
Desktop.ini

# Environment and credentials: no blanket PNG, blend or JSON exclusion.
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.secrets.json

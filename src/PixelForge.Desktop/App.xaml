<Application x:Class="PixelForge.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#20242D"/>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#11151D"/><Setter Property="Foreground" Value="#E1E6EF"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3B4353"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,4,6,4"/><Setter Property="Background" Value="#D7E2ED"/><Setter Property="Foreground" Value="#17202B"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E1E6EF"/><Setter Property="Margin" Value="0,7"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#E1E6EF"/><Setter Property="Margin" Value="0,6"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,18,0,5"/></Style>
 </Application.Resources>
</Application>
